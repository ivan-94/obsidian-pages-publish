{
  "name": "pages-publish",
  "version": "0.1.0-beta.1",
  "description": "Publish selected Obsidian notes to Cloudflare Pages.",
  "main": "main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-94/obsidian-pages-publish.git"
  },
  "bugs": {
    "url": "https://github.com/ivan-94/obsidian-pages-publish/issues"
  },
  "homepage": "https://github.com/ivan-94/obsidian-pages-publish#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run build:theme-sdk && npm run typecheck && node esbuild.config.mjs production",
    "build:theme-sdk": "tsc -p packages/theme-sdk/tsconfig.json",
    "package": "npm run build && node scripts/release-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "cloudflare-pages",
    "publishing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "beautiful-mermaid": "^1.1.3",
    "markdown-it": "^15.0.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.0"
  }
}
